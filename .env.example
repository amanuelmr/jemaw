# Database (Supabase PostgreSQL — transaction-mode pooler, port 6543, recommended for serverless)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:6543/postgres"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-here-minimum-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Google Sign-In (OAuth 2.0 Client IDs from Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URIs must include: {BETTER_AUTH_URL}/api/auth/callback/google
# e.g. http://localhost:3000/api/auth/callback/google and your production URL with the same path
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend)
# Create an API key at https://resend.com/api-keys, scoped to a domain you've verified
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Jemaw <noreply@yourdomain.com>"

# Cloudinary (server-side signed uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
